{
  "name": "mclr-contracts",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "test:general": "hardhat test test/general.test.ts",
    "test:oracle": "hardhat test test/oracle.test.ts",
    "test:lending": "hardhat test test/lending/lending8.test.ts",
    "forge:build": "forge build",
    "forge:test": "forge test -vvv",
    "forge:test:unit": "forge test --match-path 'test/foundry/unit/*' -vvv",
    "forge:test:fuzz": "forge test --match-path 'test/foundry/fuzz/*' -vvv",
    "forge:test:invariant": "forge test --match-path 'test/foundry/invariant/*' -vvv",
    "forge:test:upgrade": "forge test --match-path 'test/foundry/upgrade/*' -vvv",
    "forge:coverage": "forge coverage",
    "slither": "slither . --config-file slither.config.json",
    "slither:high": "slither . --config-file slither.config.json --exclude-informational --exclude-low",
    "slither:triage": "slither . --config-file slither.config.json --triage-mode"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@ethereumjs/util": "^9.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@nomicfoundation/hardhat-verify": "^2.0.13",
    "@openzeppelin/hardhat-upgrades": "^3.4.0",
    "@openzeppelin/upgrades-core": "^1.46.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.9",
    "chai": "^4.5.0",
    "ethers": "^6.13.3",
    "hardhat": "^2.22.19",
    "hardhat-abi-exporter": "^2.11.0",
    "hardhat-gas-reporter": "^2.2.1",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@types/node": "^22.7.4",
    "dotenv": "^16.4.5",
    "hardhat-tracer": "^3.4.0"
  }
}
